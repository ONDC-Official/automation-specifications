# Pinned tool versions for building a specification branch into an API service.
#
# Read by .github/workflows/_onix-deploy-reusable.yml, spec-workflow.yml,
# automation-framework/scripts/build-api-service.sh and automation-db (build-tools must match).
# Change a value only in a PR that runs tooling/golden/golden.sh, so every domain's generated
# output is compared before and after the bump.

NODE_VERSION=20

# npm packages (exact versions; tooling/package.json pins the same ones)
BUILD_TOOLS_VERSION=0.0.32
CODE_GENERATOR_VERSION=1.0.2
API_SERVICE_GENERATOR_VERSION=1.1.2
MOCK_RUNNER_VERSION=1.3.56

# Go plugins cloned by api-service-generator, and the ONIX runtime image they are built against.
# Read by api-service-generator once it supports pinning (until then it clones the plugins' main).
PLUGINS_REPO=https://github.com/ONDC-Official/automation-beckn-plugins
PLUGINS_REF=8b25eba1b9ca5d262d5dec2559ae9c3c66681627
ONIX_IMAGE=ghcr.io/ondc-official/automation-beckn-onix@sha256:b8f157ca992a458fb22a523ff2abc5a05efbfe282defc7c14845660c4647c224
